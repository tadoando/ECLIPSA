{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hero.schema.json",
  "title": "Lista de héroes de Eclipsia (data/heroes.json)",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "faction": { "enum": ["sol", "marea", "raiz", "umbra"] },
      "name": { "type": "string" },
      "title": { "type": "string" },
      "lore": { "type": "string" },
      "power": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "cost": { "type": "integer", "minimum": 0 },
          "text": { "type": "string" },
          "effects": { "type": "array", "items": { "$ref": "effect.schema.json" }, "minItems": 1 }
        },
        "required": ["name", "cost", "text", "effects"],
        "additionalProperties": false
      }
    },
    "required": ["id", "faction", "name", "title", "lore", "power"],
    "additionalProperties": false
  }
}
